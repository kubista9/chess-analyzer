PORT=3001
# The API binds to 127.0.0.1 by default. It has no auth and can start long engine jobs.
# HOST=0.0.0.0 # opt-in LAN exposure (the server prints a warning)
# Single-thread Stockfish workers (1-8). Depth, Threads and Hash are fixed by the engine protocol.
ENGINE_WORKERS=3
# AUTO_BACKFILL=1 # after each sync in the server, analyse the new games (mains power only)
# STOCKFISH_PATH=/absolute/path/to/stockfish # default: storage/engines/stockfish/current/stockfish
# CHESS_COM_USER_AGENT="chess-analyst-local/0.1 (contact: you@example.com)"
